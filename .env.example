# Required by cloud LLM modules such as Query Decomposer and Luna Full-Sheet Structure Detector.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
PGVECTOR_URL=postgresql://postgres:postgres@localhost:5432/rag_flow

# Optional. Configure Redis in multi-Pod/Kubernetes deployments to relay SSE
# state-change notifications between API Pods. PostgreSQL remains the source of truth.
REDIS_URL=

# Playground, Excel ingestion, BI, and benchmark calculations run through KEDA queues.

# Local k3d/KEDA batch queue. Blank max jobs means auto-detect from Docker.
KUBERNETES_WORKFLOW_QUEUE=workflow-core
KUBERNETES_MAX_JOBS=
KUBERNETES_JOB_CPU_REQUEST=1000m
KUBERNETES_JOB_MEMORY_REQUEST=2Gi
KUBERNETES_JOB_CPU_LIMIT=2
KUBERNETES_JOB_MEMORY_LIMIT=3Gi

# Excel ingestion fan-out. Kubernetes worker manifests enable this automatically.
# Keep false for a direct local one-shot worker unless the two ingestion ScaledJobs run.
INGESTION_SHARDS_ENABLED=false
INGESTION_SHARD_POLL_SECONDS=1
INGESTION_SHARD_WAIT_TIMEOUT_SECONDS=21000
INGESTION_VECTOR_SHARD_SIZE=4096

# Per-process PostgreSQL pool. One-shot Kubernetes workers use 1/4.
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
