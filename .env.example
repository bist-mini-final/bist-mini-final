# Required by cloud LLM modules such as Query Decomposer and Luna Full-Sheet Structure Detector.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
PGVECTOR_URL=postgresql://postgres:postgres@localhost:5432/rag_flow

# Playground requests run interactively; Excel ingestion always uses Prefect.
PLAYGROUND_MAX_CONCURRENCY=4

# Prefect control plane and per-Flow container resource limit.
PREFECT_API_URL=http://127.0.0.1:4200/api
PREFECT_DEPLOYMENT_NAME=excel-ingestion/docker
PREFECT_FLOW_MEMORY_LIMIT=

# Per-process PostgreSQL pool. One-shot Prefect workers override these to 1/4.
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
