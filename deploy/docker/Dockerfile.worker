FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PATH="/app/.venv/bin:${PATH}"

WORKDIR /app

RUN rm -f /etc/apt/apt.conf.d/docker-clean
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r appuser -g 1000 \
    && useradd -r -u 1000 -g appuser appuser

COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    python -m pip install uv==0.12.5 \
    && uv sync --frozen --no-dev --no-install-project

COPY backend ./backend
COPY modules ./modules
COPY jobs ./jobs
RUN mkdir -p \
    /app/data/runs \
    /app/data/cache \
    /app/data/source_files \
    /app/data/artifacts/embeddings \
    /app/data/artifacts/spreadsheets \
    && python -m compileall -q /app/backend /app/modules /app/jobs \
    && chown -R appuser:appuser /app/data

USER appuser

ENTRYPOINT ["python", "-m", "backend.entrypoints.worker"]

FROM base AS runtime

ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG SOURCE_DIRTY=false

LABEL org.opencontainers.image.title="Excel RAG workflow worker" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      io.bist.source-dirty="${SOURCE_DIRTY}"
